# environment
ENVNAME=DEV
SPRING_PROFILES_ACTIVE=devpagopa
ASPNETCORE_URLS=http://*:8080
WEBSITE_SITE_NAME=pagopacruscottosertbackend # required to show cloud role name in application insights
FUNCTIONS_WORKER_RUNTIME=java
ENVIRONMENT=dev
ENV_TAXONOMY_URL=https://api.dev.platform.pagopa.it/taxonomy/service/v1/ # taxonomy ...
ENV_BACK_OFFICE_URL=https://api.dev.platform.pagopa.it/backoffice/helpdesk/v1 # station-maintenances ...
ENV_CACHE_URL=https://api.dev.platform.pagopa.it/api-config-cache/p/v1 # /cache/keys ...
ENV_STAND_IN_URL=https://api.dev.platform.pagopa.it/stand-in/v1 # /stand-in/events ...
ENV_DATASOURCE_URL=jdbc:postgresql://pagopa-d-itn-crusc8-flexible-postgresql.postgres.database.azure.com:5432/cruscotto?sslmode=require&prepareThreshold=0&currentSchema=sert_ingestor,public
ENV_DATASOURCE_USERNAME=<ENV_DATASOURCE_USERNAME>
ENV_DATASOURCE_PASSWORD=<ENV_DATASOURCE_PASSWORD>
ENV_JWT_KEY=<ENV_JWT_KEY>
ENV_BACK_OFFICE_API_KEY_NAME=ocp-apim-subscription-key
ENV_BACK_OFFICE_API_KEY_VALUE=<ENV_BACK_OFFICE_API_KEY_VALUE>
ENV_CACHE_API_KEY_NAME=ocp-apim-subscription-key
ENV_CACHE_API_KEY_VALUE=<ENV_CACHE_API_KEY_VALUE>
ENV_STAND_IN_API_KEY_NAME=ocp-apim-subscription-key
ENV_STAND_IN_API_KEY_VALUE=<ENV_STAND_IN_API_KEY_VALUE>
AWS_ACCESS_KEY=<AWS_ACCESS_KEY>
AWS_SECRET_KEY=<AWS_SECRET_KEY>
AWS_REGION=eu-south-1
SITE_BASE_URL=<SITE_BASE_URL>
AWS_SES_USER=<AWS_SES_USER>
