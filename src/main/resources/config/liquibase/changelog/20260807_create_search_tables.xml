<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260807-01-create-search-tables" author="mamicoacc">

        <createTable tableName="SEARCH_INSTANCE">
            <column name="ID" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="NAME" type="varchar(255)"/>
            <column name="INPUT_TYPE" type="varchar(50)"/>
            <column name="STATUS" type="varchar(50)"/>
            <column name="ARCHIVED_AT" type="timestamp"/>
            <column name="LAST_EXECUTION_ID" type="uuid"/>
            <column name="CREATED_AT" type="timestamp" defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="UPDATED_AT" type="timestamp" defaultValueDate="CURRENT_TIMESTAMP"/>
        </createTable>

        <createTable tableName="SEARCH_PERIMETER_FILE">
            <column name="ID" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="INSTANCE_ID" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="SOURCE" type="varchar(50)"/>
            <column name="TEMPLATE" type="varchar(50)"/>
            <column name="FILE_NAME" type="varchar(512)"/>
            <column name="BLOB_PATH" type="varchar(1024)"/>
            <column name="ROWS_COUNT" type="int"/>
            <column name="VALIDATION_STATUS" type="varchar(50)"/>
            <column name="CREATED_AT" type="timestamp" defaultValueDate="CURRENT_TIMESTAMP"/>
        </createTable>

        <createTable tableName="SEARCH_EXECUTION">
            <column name="ID" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="INSTANCE_ID" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="STATUS" type="varchar(50)"/>
            <column name="STARTED_AT" type="timestamp"/>
            <column name="COMPLETED_AT" type="timestamp"/>
            <column name="ROWS" type="int"/>
            <column name="ERRORS" type="int"/>
            <column name="CREATED_AT" type="timestamp" defaultValueDate="CURRENT_TIMESTAMP"/>
        </createTable>

        <createTable tableName="SEARCH_RESULT">
            <column name="ID" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="INSTANCE_ID" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="EXECUTION_ID" type="uuid"/>
            <column name="ZIP_BLOB_PATH" type="varchar(1024)"/>
            <column name="ROWS_COUNT" type="int"/>
            <column name="GENERATED_AT" type="timestamp" defaultValueDate="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="SEARCH_PERIMETER_FILE" baseColumnNames="INSTANCE_ID"
                                 referencedTableName="SEARCH_INSTANCE" referencedColumnNames="ID"
                                 constraintName="fk_spf_instance" onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="SEARCH_EXECUTION" baseColumnNames="INSTANCE_ID"
                                 referencedTableName="SEARCH_INSTANCE" referencedColumnNames="ID"
                                 constraintName="fk_se_instance" onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="SEARCH_RESULT" baseColumnNames="INSTANCE_ID"
                                 referencedTableName="SEARCH_INSTANCE" referencedColumnNames="ID"
                                 constraintName="fk_sr_instance" onDelete="CASCADE"/>

        <createIndex tableName="SEARCH_INSTANCE" indexName="idx_search_instance_status">
            <column name="STATUS"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
